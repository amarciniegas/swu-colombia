---
import type { JuegoSemanal } from '../data/semanal';
import { slug } from '../utils';

interface Props {
  juego: JuegoSemanal;
  enlaceCiudad?: boolean; // muestra "Ver <ciudad>" (no hace falta dentro de la página de la ciudad)
}

const { juego, enlaceCiudad = true } = Astro.props;
const diaCorto = juego.dia.slice(0, 3).toUpperCase();
const diaPlural = juego.dia === 'Sábado' || juego.dia === 'Domingo' ? `${juego.dia.toLowerCase()}s` : juego.dia.toLowerCase();
---

<article class="semanal tarjeta evento-filtrable" data-ciudad={juego.ciudad}>
  <div class="semanal__dia" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M17 2l4 4-4 4"></path><path d="M3 11v-1a4 4 0 0 1 4-4h14"></path>
      <path d="M7 22l-4-4 4-4"></path><path d="M21 13v1a4 4 0 0 1-4 4H3"></path>
    </svg>
    <span>{diaCorto}</span>
  </div>
  <div class="semanal__info">
    <p class="etiqueta">{juego.ciudad} · Juego semanal</p>
    <h3 class="semanal__titulo">{juego.nombre} {juego.formato}</h3>
    <p class="semanal__detalle">Todos los {diaPlural} · desde las {juego.hora}</p>
    <p class="semanal__detalle">{juego.tienda}{juego.costo && ` · ${juego.costo}`}</p>
    {enlaceCiudad && (
      <a href={`/eventos/${slug(juego.ciudad)}`} class="semanal__enlace">Ver {juego.ciudad} →</a>
    )}
  </div>
</article>
