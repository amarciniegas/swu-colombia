---
// Fondo de estrellas animado para todo el sitio.
// Las estrellas se alejan del centro muy despacio (sensación de viajar por el espacio)
// y parpadean suavemente. Pensado para ser estético, no para distraer:
//  - Se pausa cuando la pestaña no está visible.
//  - Con "reducir movimiento" activado, las estrellas se quedan quietas.
---

<canvas id="fondo-estrellas" class="fondo-estrellas" aria-hidden="true"></canvas>

<style>
  .fondo-estrellas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(ellipse at 50% 40%, #0b1226 0%, var(--color-fondo) 70%);
  }
</style>

<script>
  interface Estrella {
    x: number; // posición relativa al centro
    y: number;
    z: number; // profundidad: 0.15 (lejos) a 1 (cerca)
    radio: number;
    brillo: number;
    fase: number;
    velParpadeo: number;
    color: string;
    aparicion: number; // 0→1 para que las nuevas aparezcan suavemente
  }

  const lienzo = document.getElementById('fondo-estrellas') as HTMLCanvasElement | null;
  const ctx = lienzo?.getContext('2d');

  if (lienzo && ctx) {
    const reducir = window.matchMedia('(prefers-reduced-motion: reduce)');
    const COLORES = ['255,255,255', '255,255,255', '255,255,255', '200,225,255', '255,214,218'];
    const VELOCIDAD = 6; // px por segundo para las estrellas más cercanas: muy lento a propósito

    let ancho = 0;
    let alto = 0;
    let estrellas: Estrella[] = [];
    let ultimo = 0;
    let animando = false;

    const crear = (nueva: boolean): Estrella => {
      const z = 0.15 + Math.random() * 0.85;
      // Las nuevas nacen cerca del centro; al inicio se reparten por toda la pantalla.
      const extension = nueva ? 0.15 : 0.55;
      return {
        x: (Math.random() - 0.5) * ancho * extension * 2,
        y: (Math.random() - 0.5) * alto * extension * 2,
        z,
        radio: 0.25 + z * 1.05,
        brillo: 0.25 + Math.random() * 0.55,
        fase: Math.random() * Math.PI * 2,
        velParpadeo: 0.4 + Math.random() * 1.1,
        color: COLORES[Math.floor(Math.random() * COLORES.length)],
        aparicion: nueva ? 0 : 1,
      };
    };

    const ajustar = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      ancho = window.innerWidth;
      alto = window.innerHeight;
      lienzo.width = Math.round(ancho * dpr);
      lienzo.height = Math.round(alto * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const cantidad = Math.min(220, Math.round((ancho * alto) / 8000));
      estrellas = Array.from({ length: cantidad }, () => crear(false));
    };

    const dibujar = (t: number, dt: number) => {
      ctx.clearRect(0, 0, ancho, alto);
      const cx = ancho / 2;
      const cy = alto / 2;
      const maxDist = Math.hypot(cx, cy);

      for (let i = 0; i < estrellas.length; i++) {
        const e = estrellas[i];

        if (dt > 0) {
          // Se alejan del centro; más rápido mientras más cerca (paralaje).
          const dist = Math.hypot(e.x, e.y) || 1;
          const avance = VELOCIDAD * e.z * e.z * dt * (0.4 + dist / maxDist);
          e.x += (e.x / dist) * avance;
          e.y += (e.y / dist) * avance;
          if (e.aparicion < 1) e.aparicion = Math.min(1, e.aparicion + dt * 0.25);
          if (Math.abs(e.x) > cx + 10 || Math.abs(e.y) > cy + 10) {
            estrellas[i] = crear(true);
            continue;
          }
        }

        const parpadeo = 0.75 + 0.25 * Math.sin(t * 0.001 * e.velParpadeo + e.fase);
        const alfa = e.brillo * parpadeo * e.aparicion;
        ctx.beginPath();
        ctx.arc(cx + e.x, cy + e.y, e.radio, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${e.color},${alfa.toFixed(3)})`;
        ctx.fill();
      }
    };

    const cuadro = (t: number) => {
      if (!animando) return;
      const dt = ultimo ? Math.min((t - ultimo) / 1000, 0.1) : 0;
      ultimo = t;
      dibujar(t, dt);
      requestAnimationFrame(cuadro);
    };

    const iniciar = () => {
      if (animando || reducir.matches || document.hidden) return;
      animando = true;
      ultimo = 0;
      requestAnimationFrame(cuadro);
    };

    const detener = () => {
      animando = false;
    };

    ajustar();
    dibujar(0, 0);
    iniciar();

    let espera: number | undefined;
    window.addEventListener('resize', () => {
      window.clearTimeout(espera);
      espera = window.setTimeout(() => {
        ajustar();
        dibujar(performance.now(), 0);
      }, 150);
    });

    document.addEventListener('visibilitychange', () => (document.hidden ? detener() : iniciar()));
    reducir.addEventListener('change', () => {
      if (reducir.matches) {
        detener();
        dibujar(0, 0);
      } else {
        iniciar();
      }
    });
  }
</script>
