---
import type { Tienda } from '../data/tiendas';
import type { JuegoSemanal } from '../data/semanal';
import { mapaUrl } from '../utils';

interface Props {
  tienda: Tienda;
  semanal?: JuegoSemanal[];
}

const { tienda, semanal = [] } = Astro.props;
const deEstaTienda = semanal.filter((j) => j.tienda === tienda.nombre);
---

<article class="tienda tarjeta">
  <div class="tienda__cabecera">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M3 9l1.5-5h15L21 9"></path><path d="M3 9h18v2a3 3 0 0 1-6 0 3 3 0 0 1-6 0 3 3 0 0 1-6 0V9z"></path>
      <path d="M5 13v8h14v-8"></path><path d="M10 21v-5h4v5"></path>
    </svg>
    <h3 class="tienda__nombre">{tienda.nombre}</h3>
  </div>

  <dl class="tienda__datos">
    {tienda.direccion && (
      <div>
        <dt>Dirección</dt>
        <dd>{tienda.direccion}, {tienda.ciudad}</dd>
      </div>
    )}
    {deEstaTienda.map((j) => (
      <div>
        <dt>Juego semanal</dt>
        <dd>{j.dia} · {j.hora} · {j.formato}{j.costo && ` · ${j.costo}`}</dd>
      </div>
    ))}
    {tienda.instagramUsuario && (
      <div>
        <dt>Instagram</dt>
        <dd>
          {tienda.instagramUrl ? (
            <a href={tienda.instagramUrl} target="_blank" rel="noopener noreferrer">
              @{tienda.instagramUsuario}<span class="solo-lectores"> (abre en otra pestaña)</span>
            </a>
          ) : (
            <>@{tienda.instagramUsuario}</>
          )}
        </dd>
      </div>
    )}
  </dl>

  {tienda.direccion && (
    <a href={mapaUrl(tienda)} class="boton boton--borde tienda__mapa" target="_blank" rel="noopener noreferrer">
      Ver en el mapa<span class="solo-lectores"> (abre Google Maps en otra pestaña)</span>
    </a>
  )}
</article>

<style>
  .tienda {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .tienda__cabecera {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--color-heroe-texto);
  }

  .tienda__nombre {
    font-size: 22px;
    font-weight: 800;
    color: var(--color-texto);
  }

  .tienda__datos {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .tienda__datos div {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .tienda__datos dt {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--color-texto-suave);
  }

  .tienda__datos dd {
    margin: 0;
    font-size: 16px;
    color: var(--color-texto);
  }

  .tienda__mapa {
    align-self: flex-start;
  }
</style>
