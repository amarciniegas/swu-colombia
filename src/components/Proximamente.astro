---
// Página temporal para las secciones que aún no están construidas.
import BaseLayout from '../layouts/BaseLayout.astro';
import Estrella from './Estrella.astro';

interface Props {
  titulo: string;
  descripcion: string;
}

const { titulo, descripcion } = Astro.props;
---

<BaseLayout titulo={titulo} descripcion={descripcion}>
  <section class="seccion">
    <div class="contenedor proximamente">
      <Estrella tamano={64} />
      <h1 class="proximamente__titulo">{titulo}</h1>
      <p class="proximamente__texto">{descripcion}</p>
      <p class="proximamente__texto">Esta sección está en construcción. ¡Muy pronto!</p>
      <a href="/" class="boton boton--marino">Volver al inicio</a>
    </div>
  </section>
</BaseLayout>

<style>
  .proximamente {
    min-height: 50vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 16px;
  }

  .proximamente__titulo {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 800;
  }

  .proximamente__texto {
    max-width: 520px;
    color: var(--color-texto-suave);
    font-size: 17px;
  }
</style>
