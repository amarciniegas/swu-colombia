---
import type { Noticia } from '../data/noticias';

interface Props {
  noticia: Noticia;
}

const { noticia } = Astro.props;
const fecha = new Date(`${noticia.fecha}T12:00:00Z`).toLocaleDateString('es-CO', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
const colorCategoria = {
  Estrategia: '',
  Expansiones: 'etiqueta--amarillo',
  'Reporte de torneo': 'etiqueta--villano',
}[noticia.categoria];
---

<article class="noticia tarjeta">
  <div class="noticia__imagen" aria-hidden="true">
    <svg width="40" height="40" viewBox="0 0 88 88"><path d="M44 4 C47 32 56 41 84 44 C56 47 47 56 44 84 C41 56 32 47 4 44 C32 41 41 32 44 4 Z" fill="#2e3b60"></path></svg>
  </div>
  <div class="noticia__cuerpo">
    <p class:list={['etiqueta', colorCategoria]}>{noticia.categoria}</p>
    <h3 class="noticia__titulo">
      <a href={noticia.href}>{noticia.titulo}</a>
    </h3>
    <p class="noticia__meta">{noticia.autor} · <time datetime={noticia.fecha}>{fecha}</time></p>
  </div>
</article>

<style>
  .noticia {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 0.15s ease;
  }

  .noticia:hover {
    border-color: var(--color-borde-fuerte);
  }

  .noticia__imagen {
    height: 168px;
    background: var(--color-superficie-2);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .noticia__cuerpo {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .noticia__titulo {
    font-size: 20px;
    font-weight: 700;
    line-height: 1.3;
  }

  .noticia__titulo a {
    color: var(--color-texto);
    text-decoration: none;
  }

  /* Toda la tarjeta es clicable, pero el enlace sigue siendo el título */
  .noticia__titulo a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .noticia__titulo a:hover {
    text-decoration: underline;
  }

  .noticia__meta {
    font-size: 14px;
    color: var(--color-texto-suave);
  }
</style>
