---
import '@fontsource-variable/outfit';
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { sitio } from '../data/sitio';

interface Props {
  titulo?: string;
  descripcion?: string;
}

const { titulo, descripcion = sitio.descripcion } = Astro.props;
const tituloCompleto = titulo ? `${titulo} · ${sitio.nombre}` : `${sitio.nombre} · Comunidad de Star Wars: Unlimited`;
const urlCanonica = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={urlCanonica} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#070b16" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:locale" content="es_CO" />
  </head>
  <body>
    <a href="#contenido" class="saltar">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .saltar {
    position: absolute;
    left: 16px;
    top: -60px;
    z-index: 10;
    padding: 12px 16px;
    background: var(--color-amarillo);
    color: var(--color-fondo);
    border-radius: 8px;
  }

  .saltar:focus {
    top: 16px;
  }
</style>
